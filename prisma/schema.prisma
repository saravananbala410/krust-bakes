generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  ONLINE
  UPI
  PAY_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum JourneyEventType {
  PRODUCT_VIEWED
  CART_ITEM_ADDED
  CART_ITEM_REMOVED
  CHECKOUT_STARTED
  PAYMENT_ATTEMPTED
  PAYMENT_FAILED
  ORDER_COMPLETED
  CHECKOUT_ABANDONED
  RECOVERY_CONTACTED
  RECOVERY_COMPLETED
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  phone         String?        @unique
  whatsapp      String?
  passwordHash  String?
  role          Role           @default(CUSTOMER)
  orders        Order[]
  journeyEvents JourneyEvent[]
  auditLogs     AuditLog[]      @relation("AuditActor")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([role])
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  category    String
  ingredients String?
  allergenTags String[]
  isEggless   Boolean       @default(false)
  hsnCode     String
  gstRate     Decimal       @db.Decimal(5, 2)
  imageUrl    String?
  status      ProductStatus @default(ACTIVE)
  variants    Variant[]
  orderItems  OrderItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category, status])
}

model Variant {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  sku         String      @unique
  price       Decimal     @db.Decimal(10, 2)
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([productId, isActive])
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  userId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName      String
  phone             String
  whatsapp          String?
  deliveryAddress   String
  landmark          String?
  city              String
  pincode            String
  deliveryDate      DateTime
  deliverySlot      String
  customerNote      String?
  internalStaffNote String?
  status            OrderStatus   @default(PENDING)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  subtotal           Decimal       @db.Decimal(10, 2)
  taxableValue       Decimal       @db.Decimal(10, 2)
  cgstTotal          Decimal       @db.Decimal(10, 2)
  sgstTotal          Decimal       @db.Decimal(10, 2)
  igstTotal          Decimal       @db.Decimal(10, 2)
  deliveryFee        Decimal       @db.Decimal(10, 2) @default(0)
  grandTotal         Decimal       @db.Decimal(10, 2)
  isInterstate       Boolean       @default(false)
  items              OrderItem[]
  journeyEvents      JourneyEvent[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  completedAt        DateTime?

  @@index([status, createdAt])
  @@index([phone])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId         String?
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId         String?
  variant           Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName       String
  variantName       String
  hsnCodeSnapshot   String
  gstRateSnapshot   Decimal  @db.Decimal(5, 2)
  unitPriceInclusive Decimal @db.Decimal(10, 2)
  quantity          Int
  lineTotal         Decimal  @db.Decimal(10, 2)
  taxableValue      Decimal  @db.Decimal(10, 2)
  cgstAmount        Decimal  @db.Decimal(10, 2)
  sgstAmount        Decimal  @db.Decimal(10, 2)
  igstAmount        Decimal  @db.Decimal(10, 2)

  @@index([orderId])
}

model StoreConfig {
  id                    String   @id @default("primary")
  storeName             String
  address               String
  googleMapsUrl         String?
  phone                  String
  whatsapp               String
  email                  String
  openingHours           Json
  gstin                   String
  fssaiNumber             String
  minimumDeliveryValue   Decimal  @db.Decimal(10, 2)
  abandonedAfterMinutes  Int      @default(30)
  updatedById             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model JourneyEvent {
  id          String           @id @default(cuid())
  sessionId   String
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId     String?
  order       Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type        JourneyEventType
  metadata    Json?
  occurredAt  DateTime         @default(now())

  @@index([sessionId, occurredAt])
  @@index([type, occurredAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
